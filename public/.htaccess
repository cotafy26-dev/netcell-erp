# index.html = página de vendas (estática) — servida direto em "/", sem reescrita.
# Qualquer outra rota que não seja um arquivo/pasta real (/login, /admin,
# /admin/clientes, /portal...) cai no shell do React em app.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^(index|app)\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /app.html [L]
</IfModule>

# cache dos assets com hash
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# PWA: MIME do manifest
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
